# CloudOps Alert Bridge — configuração local do Jira Cloud
#
# 1. Copie este arquivo:  Copy-Item .env.example .env
# 2. Preencha o .env com seus dados reais (ele está no .gitignore).
# 3. Os valores abaixo são fictícios.

# URL do seu site Jira Cloud (somente o domínio, com https://)
JIRA_BASE_URL=https://sua-empresa.atlassian.net

# E-mail da conta Atlassian dona do token
JIRA_EMAIL=voce@example.com

# API token clássico (sem escopos), criado em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=cole-seu-token-aqui

# Chave do projeto (padrão: KAN)
JIRA_PROJECT_KEY=KAN

# Tipo de issue: nome OU id. Descubra os válidos com:  python -m scripts.jira_check
# (Em sites em português o nome pode ser "Tarefa", por exemplo.)
JIRA_ISSUE_TYPE=Task

# Opcional: mapeamento severidade -> prioridade do Jira (nome ou id).
# Deixe VAZIO se o campo Prioridade não estiver disponível na criação (o script jira_check informa).
# Exemplo: JIRA_PRIORITY_MAP=P1=Highest,P2=High,P3=Medium,P4=Low
JIRA_PRIORITY_MAP=

# Opcional: timeout das chamadas ao Jira, em segundos (padrão 10)
JIRA_TIMEOUT_SECONDS=10
